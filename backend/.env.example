# HuggingFace API Configuration
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Model to use from HuggingFace Inference API
# Recommended models that work well:
# 
#   google/flan-t5-base (DEFAULT - fast, works without approval)
#   google/flan-t5-large (better quality, slightly slower)
#   mistralai/Mistral-7B-Instruct-v0.1 (high quality, recommended)
#   meta-llama/Llama-2-7b-chat-hf (excellent, but requires approval)
#   meta-llama/Llama-2-13b-chat-hf (larger, higher quality)
#   gpt2 (basic fallback, always available)
#
# Avoid models that don't work with conversational API:
#   mistralai/Mistral-7B-Instruct-v0.2 (not supported by some providers)
#
HF_MODEL=google/flan-t5-base

# Server Configuration
PORT=3000
ALLOWED_ORIGIN=*

# Database (SQLite)
# Path to SQLite database file storing embeddings
# Default: ./collective_memory.db (set in config.py)

{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://collective-ai-backend.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}





{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/:match*", "dest": "https://collective-ai.onrender.com/api/:match*" },
    { "src": "/(.*)", "status": 404, "dest": "/frontend/page_not_found.html" }
  ]
}
{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
